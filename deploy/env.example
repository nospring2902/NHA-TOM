# =============================================================================
# NHATOM — Biến môi trường deploy (copy thành .env ở thư mục gốc repo)
# cp deploy/env.example .env
# =============================================================================

# --- Docker Compose (postgres service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nhatom
POSTGRES_PORT=5432

# Port publish ra ngoài (khi dùng docker compose full stack)
API_PORT=3000
WEB_PORT=8080

# --- Frontend build (docker compose / npm run build) ---
VITE_API_BASE_URL=https://api.nhatom.vn/api/v1

# --- Backend server ---
PORT=3000
NODE_ENV=production

# Dùng khi chạy backend bằng PM2 (không qua docker compose api service)
DATABASE_URL=postgresql://postgres:change-me-strong-db-password@localhost:5432/nhatom?schema=public

# Domain frontend (CORS)
CORS_ORIGINS=https://nhatom.vn,https://www.nhatom.vn
FRONTEND_ORIGIN=https://nhatom.vn

# --- Auth ---
JWT_ACCESS_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
VERIFICATION_CODE_SECRET=change-me-verification-secret
VERIFICATION_CODE_TTL_MINUTES=10

# --- Device token encryption ---
DEVICE_TOKEN_ENCRYPTION_KEY=change-me-device-encryption-key

# --- Admin bootstrap (tạo admin nhatom@gmail.com khi khởi động) ---
ADMIN_BOOTSTRAP_PHONE=0901234567

# --- Email (bắt buộc nếu dùng xác minh / quên MK / cảnh báo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Nhà Tôm <no-reply@nhatom.vn>

# --- ThingsBoard (thiết bị IoT) ---
THINGSBOARD_BASE_URL=https://iot.nhatom.vn
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=change-me-thingsboard-password
THINGSBOARD_INGEST_TOKEN=change-me-ingest-webhook-token
# THINGSBOARD_STATUS_CHANGE_TOKEN=optional-separate-token

# --- Device heartbeat ---
DEVICE_HEARTBEAT_TIMEOUT_MS=5000

# --- AI forecast (tuỳ chọn, mặc định dùng backend/ai/) ---
# NHATOM_AI_MODEL_PATH=/app/ai/nhatom_forecast.onnx
# NHATOM_AI_SCALER_PATH=/app/ai/nhatom_scaler.json
# NHATOM_AI_LOOKBACK_DAYS=14
# NHATOM_AI_FORECAST_DAYS=1,3,7
