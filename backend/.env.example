# Copy file này thành .env khi chạy backend bằng PM2 hoặc npm run start:prod
# cp deploy/env.example backend/.env  (hoặc tạo backend/.env thủ công)

PORT=3000
NODE_ENV=production

DATABASE_URL=postgresql://postgres:change-me-strong-db-password@localhost:5432/nhatom?schema=public

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:8080

JWT_ACCESS_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
VERIFICATION_CODE_SECRET=change-me-verification-secret
VERIFICATION_CODE_TTL_MINUTES=10

DEVICE_TOKEN_ENCRYPTION_KEY=change-me-device-encryption-key
ADMIN_BOOTSTRAP_PHONE=0901234567

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Nhà Tôm <no-reply@nhatom.local>

THINGSBOARD_BASE_URL=http://127.0.0.1:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant
THINGSBOARD_INGEST_TOKEN=change-me-ingest-webhook-token

DEVICE_HEARTBEAT_TIMEOUT_MS=5000
