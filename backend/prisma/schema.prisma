generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FARM_MANAGER
  FARM_STAFF
  ANALYST
}

enum PondWaterType {
  FRESH
  BRACKISH
  SALINE
}

enum PondLifecycleStatus {
  PROVISIONING
  ACTIVE
  ARCHIVED
}

enum DeviceType {
  SENSOR_GATEWAY
  AERATOR
  PUMP
  LIGHT
  FEEDER
}

enum DeviceStatus {
  INACTIVE
  WAITING_SIGNAL
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum InventoryStatus {
  AVAILABLE
  ACTIVATED
  BLOCKED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum MetricQualityFlag {
  VALID
  OUTLIER
  MISSING
  IMPUTED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FarmInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  fullName             String
  passwordHash         String
  phone                String?
  avatarUrl            String?
  emailVerifiedAt      DateTime?
  emailVerificationCodeHash String?
  emailVerificationExpiresAt DateTime?
  pendingPasswordHash        String?
  passwordChangeCodeHash     String?
  passwordChangeExpiresAt    DateTime?
  role                 UserRole          @default(FARM_STAFF)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ownedPonds           Pond[]            @relation("PondOwner")
  sessions             UserSession[]
  pondMemberships      PondMember[]
  activityLogs         ActivityLog[]
  posts                Post[]
  postLikes            PostLike[]
  postComments         PostComment[]
  friends              Friend[]          @relation("UserFriends")
  friendOf             Friend[]          @relation("UserFriendOf")
  sentFriendRequests   FriendRequest[]   @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  sentMessages         ChatMessage[]     @relation("ChatSender")
  receivedMessages     ChatMessage[]     @relation("ChatRecipient")
  commandRequests      DeviceCommand[]   @relation("CommandRequestedBy")
  provisionedDevices   Device[]          @relation("DeviceOwner")
  activatedInventories DeviceInventory[] @relation("InventoryActivatedBy")
  sentFarmInvites      FarmInvite[]      @relation("FarmInviteSender")
  receivedFarmInvites  FarmInvite[]      @relation("FarmInviteRecipient")
  ownedFarmMembers     FarmMember[]      @relation("FarmOwnerMembers")
  memberOfFarms        FarmMember[]      @relation("FarmMemberOf")
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        Task[]            @relation("TaskAssignee")
  notifications        Notification[]

  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Pond {
  id                  String              @id @default(uuid())
  ownerId             String
  name                String
  farmName            String
  province            String
  district            String
  ward                String
  areaM2              Float
  averageDepthM       Float
  latitude            Float?
  longitude           Float?
  waterType           PondWaterType
  lifecycleStatus     PondLifecycleStatus @default(PROVISIONING)
  timezone            String              @default("Asia/Ho_Chi_Minh")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  owner               User                @relation("PondOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             PondMember[]
  activatedInventories DeviceInventory[]  @relation("InventoryActivatedPond")
  pondDevices         PondDevice[]
  telemetryRaw        TelemetryRaw[]
  metricSnapshots     PondMetricSnapshot[]
  latestMetric        PondMetricLatest?
  alerts              Alert[]
  activityLogs        ActivityLog[]
  posts               Post[]
  commandRequests     DeviceCommand[]
  tasks               Task[]

  @@index([ownerId])
  @@index([lifecycleStatus, createdAt])
  @@map("ponds")
}

model PondMember {
  id        String   @id @default(uuid())
  pondId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  pond      Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pondId, userId])
  @@index([userId])
  @@map("pond_members")
}

model DeviceInventory {
  serialNumber      String          @id
  model             String
  type              DeviceType
  status            InventoryStatus @default(AVAILABLE)
  activatedByUserId String?
  activatedPondId   String?
  activatedAt       DateTime?
  createdAt         DateTime        @default(now())
  activatedByUser   User?           @relation("InventoryActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  activatedPond     Pond?           @relation("InventoryActivatedPond", fields: [activatedPondId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([activatedPondId])
  @@map("device_inventory")
}

model Device {
  id                 String               @id @default(uuid())
  serialNumber       String               @unique
  accessToken        String?              @unique
  tbDeviceId         String?              @unique
  ownerId            String?
  model              String
  type               DeviceType
  isActive           Boolean              @default(false)
  status             DeviceStatus         @default(INACTIVE)
  telemetryPackets   Int                  @default(0)
  lastTelemetryAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              User?                @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pondBindings       PondDevice[]
  telemetryRaw       TelemetryRaw[]
  metricSnapshots    PondMetricSnapshot[]
  commandRequests    DeviceCommand[]

  @@index([ownerId])
  @@index([status, updatedAt])
  @@map("devices")
}

model PondDevice {
  id        String   @id @default(uuid())
  pondId    String
  deviceId  String
  boundAt   DateTime @default(now())
  unboundAt DateTime?
  isPrimary Boolean  @default(false)
  pond      Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([pondId, boundAt])
  @@index([deviceId, boundAt])
  @@map("pond_devices")
}

model TelemetryRaw {
  id          BigInt   @id @default(autoincrement())
  eventId     String   @unique
  pondId      String
  deviceId    String
  tsUtc       DateTime
  payload     Json
  source      String   @default("thingsboard")
  ingestStatus String  @default("accepted")
  createdAt   DateTime @default(now())
  pond        Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([pondId, tsUtc])
  @@index([deviceId, tsUtc])
  @@map("telemetry_raw")
}

model PondMetricSnapshot {
  id              BigInt            @id @default(autoincrement())
  pondId          String
  deviceId        String?
  tsUtc           DateTime
  ph              Float?
  dissolvedOxygen Float?
  temperature     Float?
  salinity        Float?
  qualityFlag     MetricQualityFlag @default(VALID)
  createdAt       DateTime          @default(now())
  pond            Pond              @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device          Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([pondId, tsUtc])
  @@index([deviceId, tsUtc])
  @@map("pond_metric_snapshots")
}

model PondMetricLatest {
  pondId          String   @id
  ph              Float?
  dissolvedOxygen Float?
  temperature     Float?
  salinity        Float?
  updatedAt       DateTime @default(now())
  pond            Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@map("pond_metric_latest")
}

model Alert {
  id           String        @id @default(uuid())
  pondId       String
  severity     AlertSeverity
  status       AlertStatus   @default(OPEN)
  metricKey    String?
  message      String
  predictedFor DateTime?
  acknowledgedAt DateTime?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  pond         Pond          @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@index([pondId, status, severity, createdAt])
  @@map("alerts")
}

model DeviceCommand {
  id                String   @id @default(uuid())
  pondId            String
  deviceId          String
  action            String
  reason            String?
  requestedByUserId String?
  queuedAt          DateTime @default(now())
  sentAt            DateTime?
  ackAt             DateTime?
  result            Json?
  createdAt         DateTime @default(now())
  pond              Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedByUser   User?    @relation("CommandRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([pondId, queuedAt])
  @@index([deviceId, queuedAt])
  @@map("device_commands")
}

model ActivityLog {
  id          String   @id @default(uuid())
  pondId      String?
  actorUserId String?
  actorType   String
  action      String
  trigger     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  pond        Pond?    @relation(fields: [pondId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([pondId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("activity_logs")
}

model Post {
  id           String   @id @default(uuid())
  pondId       String?
  authorUserId String
  content      String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pond         Pond?    @relation(fields: [pondId], references: [id], onDelete: SetNull)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  comments     PostComment[]

  @@index([authorUserId, createdAt])
  @@index([pondId, createdAt])
  @@map("posts")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
  @@map("post_likes")
}

model PostComment {
  id           String   @id @default(uuid())
  postId       String
  authorUserId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("post_comments")
}

model Friend {
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
  @@map("friends")
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  requester   User                @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status, createdAt])
  @@map("friend_requests")
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())
  sender      User     @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("chat_messages")
}

model FarmInvite {
  id        String           @id @default(uuid())
  ownerId   String
  inviteeId String
  status    FarmInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  owner     User             @relation("FarmInviteSender", fields: [ownerId], references: [id], onDelete: Cascade)
  invitee   User             @relation("FarmInviteRecipient", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([ownerId, inviteeId])
  @@index([inviteeId, status])
  @@map("farm_invites")
}

model FarmMember {
  id        String   @id @default(uuid())
  ownerId   String
  memberId  String
  createdAt DateTime @default(now())
  owner     User     @relation("FarmOwnerMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  member    User     @relation("FarmMemberOf", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId])
  @@index([memberId])
  @@map("farm_members")
}

model Task {
  id          String       @id @default(uuid())
  pondId      String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  creatorId   String
  assigneeId  String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pond        Pond         @relation(fields: [pondId], references: [id], onDelete: Cascade)
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([pondId, status])
  @@index([assigneeId, status])
  @@index([creatorId])
  @@map("tasks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
