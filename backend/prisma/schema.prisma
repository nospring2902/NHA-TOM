generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FARM_MANAGER
  FARM_STAFF
  ANALYST
}

enum PondWaterType {
  FRESH
  BRACKISH
  SALINE
}

enum PondLifecycleStatus {
  PROVISIONING
  ACTIVE
  ARCHIVED
}

enum DeviceType {
  SENSOR_GATEWAY
  AERATOR
  PUMP
  LIGHT
  FEEDER
}

enum DeviceStatus {
  INACTIVE
  WAITING_SIGNAL
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum InventoryStatus {
  AVAILABLE
  ACTIVATED
  BLOCKED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum MetricQualityFlag {
  VALID
  OUTLIER
  MISSING
  IMPUTED
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  fullName             String
  passwordHash         String
  role                 UserRole          @default(FARM_STAFF)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ownedPonds           Pond[]            @relation("PondOwner")
  sessions             UserSession[]
  pondMemberships      PondMember[]
  activityLogs         ActivityLog[]
  posts                Post[]
  commandRequests      DeviceCommand[]   @relation("CommandRequestedBy")
  provisionedDevices   Device[]          @relation("DeviceOwner")
  activatedInventories DeviceInventory[] @relation("InventoryActivatedBy")

  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Pond {
  id                  String              @id @default(uuid())
  ownerId             String
  name                String
  farmName            String
  province            String
  district            String
  ward                String
  areaM2              Float
  averageDepthM       Float
  latitude            Float?
  longitude           Float?
  waterType           PondWaterType
  lifecycleStatus     PondLifecycleStatus @default(PROVISIONING)
  timezone            String              @default("Asia/Ho_Chi_Minh")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  owner               User                @relation("PondOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             PondMember[]
  activatedInventories DeviceInventory[]  @relation("InventoryActivatedPond")
  pondDevices         PondDevice[]
  telemetryRaw        TelemetryRaw[]
  metricSnapshots     PondMetricSnapshot[]
  latestMetric        PondMetricLatest?
  alerts              Alert[]
  activityLogs        ActivityLog[]
  posts               Post[]
  commandRequests     DeviceCommand[]

  @@index([ownerId])
  @@index([lifecycleStatus, createdAt])
  @@map("ponds")
}

model PondMember {
  id        String   @id @default(uuid())
  pondId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  pond      Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pondId, userId])
  @@index([userId])
  @@map("pond_members")
}

model DeviceInventory {
  serialNumber      String          @id
  model             String
  type              DeviceType
  status            InventoryStatus @default(AVAILABLE)
  activatedByUserId String?
  activatedPondId   String?
  activatedAt       DateTime?
  createdAt         DateTime        @default(now())
  activatedByUser   User?           @relation("InventoryActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  activatedPond     Pond?           @relation("InventoryActivatedPond", fields: [activatedPondId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([activatedPondId])
  @@map("device_inventory")
}

model Device {
  id                 String               @id @default(uuid())
  serialNumber       String               @unique
  accessToken        String?              @unique
  tbDeviceId         String?              @unique
  ownerId            String?
  model              String
  type               DeviceType
  isActive           Boolean              @default(false)
  status             DeviceStatus         @default(INACTIVE)
  telemetryPackets   Int                  @default(0)
  lastTelemetryAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              User?                @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pondBindings       PondDevice[]
  telemetryRaw       TelemetryRaw[]
  metricSnapshots    PondMetricSnapshot[]
  commandRequests    DeviceCommand[]

  @@index([ownerId])
  @@index([status, updatedAt])
  @@map("devices")
}

model PondDevice {
  id        String   @id @default(uuid())
  pondId    String
  deviceId  String
  boundAt   DateTime @default(now())
  unboundAt DateTime?
  isPrimary Boolean  @default(false)
  pond      Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([pondId, boundAt])
  @@index([deviceId, boundAt])
  @@map("pond_devices")
}

model TelemetryRaw {
  id          BigInt   @id @default(autoincrement())
  eventId     String   @unique
  pondId      String
  deviceId    String
  tsUtc       DateTime
  payload     Json
  source      String   @default("thingsboard")
  ingestStatus String  @default("accepted")
  createdAt   DateTime @default(now())
  pond        Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([pondId, tsUtc])
  @@index([deviceId, tsUtc])
  @@map("telemetry_raw")
}

model PondMetricSnapshot {
  id              BigInt            @id @default(autoincrement())
  pondId          String
  deviceId        String?
  tsUtc           DateTime
  ph              Float?
  dissolvedOxygen Float?
  temperature     Float?
  salinity        Float?
  qualityFlag     MetricQualityFlag @default(VALID)
  createdAt       DateTime          @default(now())
  pond            Pond              @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device          Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([pondId, tsUtc])
  @@index([deviceId, tsUtc])
  @@map("pond_metric_snapshots")
}

model PondMetricLatest {
  pondId          String   @id
  ph              Float?
  dissolvedOxygen Float?
  temperature     Float?
  salinity        Float?
  updatedAt       DateTime @default(now())
  pond            Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@map("pond_metric_latest")
}

model Alert {
  id           String        @id @default(uuid())
  pondId       String
  severity     AlertSeverity
  status       AlertStatus   @default(OPEN)
  metricKey    String?
  message      String
  predictedFor DateTime?
  acknowledgedAt DateTime?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  pond         Pond          @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@index([pondId, status, severity, createdAt])
  @@map("alerts")
}

model DeviceCommand {
  id                String   @id @default(uuid())
  pondId            String
  deviceId          String
  action            String
  reason            String?
  requestedByUserId String?
  queuedAt          DateTime @default(now())
  sentAt            DateTime?
  ackAt             DateTime?
  result            Json?
  createdAt         DateTime @default(now())
  pond              Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedByUser   User?    @relation("CommandRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([pondId, queuedAt])
  @@index([deviceId, queuedAt])
  @@map("device_commands")
}

model ActivityLog {
  id          String   @id @default(uuid())
  pondId      String?
  actorUserId String?
  actorType   String
  action      String
  trigger     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  pond        Pond?    @relation(fields: [pondId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([pondId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("activity_logs")
}

model Post {
  id           String   @id @default(uuid())
  pondId       String?
  authorUserId String
  content      String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pond         Pond?    @relation(fields: [pondId], references: [id], onDelete: SetNull)
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([authorUserId, createdAt])
  @@index([pondId, createdAt])
  @@map("posts")
}
